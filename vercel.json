{
    "version": 2,
    "functions": {
        "api/index.js": {
            "maxDuration": 30,
            "memory": 1024
        }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/api/index.js"
        }
    ],
    "crons": [
        {
            "path": "/api/maintenance/cleanup-ip",
            "schedule": "0 2 * * *"
        }
    ]
}